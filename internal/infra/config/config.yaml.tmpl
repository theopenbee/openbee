language: {{.Language}}

server:
  port: {{.ServerPort}}
  host: {{.ServerHost}}
  debug: {{.Debug}}
  auth:
    username: "{{.AuthUsername}}"
    password: "{{.AuthPassword}}"
    jwt_secret: "{{.AuthJWTSecret}}"
    access_token_ttl: {{.AuthAccessTTL}}
    refresh_token_ttl: {{.AuthRefreshTTL}}
  env_secret: "{{.ServerEnvSecret}}"

database:
  path: {{.DBPath}}

bee:
  engine:
    default: {{.EngineDefault}}
    timeout:
      bee: {{.EngineTimeoutBee}}
      worker: {{.EngineTimeoutWorker}}
  engines:
    claude:
      enabled: {{.ClaudeEnabled}}
      path: {{.ClaudePath}}
    codex:
      enabled: {{.CodexEnabled}}
      path: {{.CodexPath}}
    pi:
      enabled: {{.PiEnabled}}
      path: {{.PiPath}}
  rpc:
    token_secret: "{{.RPCTokenSecret}}"
    token_ttl: {{.RPCTokenTTL}}
  platforms:
    weixin:
      enabled: {{.WeixinEnabled}}
      token: "{{.WeixinToken}}"
      base_url: "{{.WeixinBaseURL}}"
      cdn_base_url: "{{.WeixinCDNBaseURL}}"
      user_id: "{{.WeixinUserID}}"
      bot_name: "{{.WeixinBotName}}"
    linear:
      enabled: {{.LinearEnabled}}
      api_key: "{{.LinearAPIKey}}"
      label_name: "{{.LinearLabelName}}"
      poll_interval: {{.LinearPollInterval}}
      projects: [{{.LinearProjectsYAML}}]
      states: [{{.LinearStatesYAML}}]
      max_media_size: {{.LinearMaxMediaSize}}
{{- if .PluginPlatformsYAML}}
{{.PluginPlatformsYAML}}{{end}}
  feeder:
    max_concurrent_bee: {{.FeederMaxConcurrentBee}}
  media:
    ffmpeg_path: {{.FFmpegPath}}
  message_debounce: {{.MessageDebounce}}
