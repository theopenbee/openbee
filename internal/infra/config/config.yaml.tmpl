language: {{.Language}}

server:
  port: {{.ServerPort}}
  host: {{.ServerHost}}
  debug: {{.Debug}}
  auth:
    username: "{{.AuthUsername}}"
    password: "{{.AuthPassword}}"
    jwt_secret: "{{.AuthJWTSecret}}"
    access_token_ttl: {{.AuthAccessTTL}}
    refresh_token_ttl: {{.AuthRefreshTTL}}
  env_secret: "{{.ServerEnvSecret}}"

database:
  path: {{.DBPath}}

bee:
  engine:
    default: {{.EngineDefault}}
    timeout:
      bee: {{.EngineTimeoutBee}}
      worker: {{.EngineTimeoutWorker}}
  engines:
    claude:
      enabled: {{.ClaudeEnabled}}
      path: {{.ClaudePath}}
    codex:
      enabled: {{.CodexEnabled}}
      path: {{.CodexPath}}
    pi:
      enabled: {{.PiEnabled}}
      path: {{.PiPath}}
  rpc:
    token_secret: "{{.RPCTokenSecret}}"
    token_ttl: {{.RPCTokenTTL}}
  platforms:{{if .PluginPlatformsYAML}}
{{.PluginPlatformsYAML}}{{else}} {}{{end}}
  feeder:
    max_concurrent_bee: {{.FeederMaxConcurrentBee}}
  message_debounce: {{.MessageDebounce}}
