language: {{.Language}}

server:
  port: {{.ServerPort}}
  host: {{.ServerHost}}
  debug: {{.Debug}}
  auth:
    username: "{{.AuthUsername}}"
    password: "{{.AuthPassword}}"
    jwt_secret: "{{.AuthJWTSecret}}"
    access_token_ttl: {{.AuthAccessTTL}}
    refresh_token_ttl: {{.AuthRefreshTTL}}

database:
  path: {{.DBPath}}

bee:
  claude:
    path: {{.ClaudePath}}
    timeout: {{.ClaudeTimeout}}
  mcp:
    token_secret: "{{.MCPTokenSecret}}"
    token_ttl: {{.MCPTokenTTL}}
  platforms:
    feishu:
      enabled: {{.FeishuEnabled}}
      app_id: "{{.FeishuAppID}}"
      app_secret: "{{.FeishuAppSecret}}"
    dingtalk:
      enabled: {{.DingtalkEnabled}}
      client_id: "{{.DingtalkClientID}}"
      client_secret: "{{.DingtalkClientSecret}}"
    wecom:
      enabled: {{.WecomEnabled}}
      bot_id: "{{.WecomBotID}}"
      secret: "{{.WecomSecret}}"
    telegram:
      enabled: {{.TelegramEnabled}}
      token: "{{.TelegramToken}}"
      auth_code: "{{.TelegramAuthCode}}"
    weixin:
      enabled: {{.WeixinEnabled}}
      token: "{{.WeixinToken}}"
      base_url: "{{.WeixinBaseURL}}"
      cdn_base_url: "{{.WeixinCDNBaseURL}}"
      user_id: "{{.WeixinUserID}}"
  feeder:
    timeout: {{.FeederTimeout}}
    max_concurrent_bee: {{.FeederMaxConcurrentBee}}
  media:
    ffprobe_path: {{.FFprobePath}}
    ffmpeg_path: {{.FFmpegPath}}
  message_debounce: {{.MessageDebounce}}
