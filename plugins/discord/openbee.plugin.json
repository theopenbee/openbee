{
  "protocol_version": 1,
  "id": "discord",
  "name": { "en": "Discord", "zh": "Discord" },
  "description": { "en": "Discord bot channel (reference plugin)", "zh": "Discord 机器人渠道（参考插件）" },
  "command": ["node", "dist/index.js"],
  "config": [
    {
      "key": "token",
      "type": "secret",
      "required": true,
      "label": { "en": "Bot token", "zh": "机器人 Token" },
      "help": { "en": "Discord Developer Portal → your application → Bot → Reset Token", "zh": "Discord 开发者后台 → 你的应用 → Bot → Reset Token" }
    },
    {
      "key": "allowed_guilds",
      "type": "list",
      "label": { "en": "Allowed server IDs (empty = all)", "zh": "允许的服务器 ID（留空表示全部）" }
    },
    {
      "key": "max_media_size",
      "type": "int",
      "default": 10485760,
      "label": { "en": "Max inbound attachment size (bytes)", "zh": "接收附件大小上限（字节）" }
    }
  ]
}
